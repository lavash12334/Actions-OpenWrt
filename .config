# Платформа и Устройство
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g=y

# Процессор (Разгон настраивается в dts, но эти пакеты помогут мониторить)
CONFIG_PACKAGE_luci-app-cpufreq=y

# Обход блокировок и VPN (Твой профиль)
CONFIG_PACKAGE_luci-app-zapret=y
CONFIG_PACKAGE_luci-i18n-zapret-ru=y
CONFIG_PACKAGE_luci-app-amneziawg=y
CONFIG_PACKAGE_kmod-amneziawg=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_luci-app-vssr=y
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-ru=y

# Раздельное туннелирование (Пункт 40)
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_pbr-netifd=y

# Системный "Жир" (Python, Bash, Git)
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_git=y
CONFIG_PACKAGE_git-http=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y

# Мониторинг и Управление
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-app-sqm=y

# Файловая система для флешки (NTFS/exFAT)
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_luci-app-aria2=y

# Удаление лишнего (IPv6)
# CONFIG_IPV6 is not set
# CONFIG_PACKAGE_ipv6helper is not set

# Локализация
CONFIG_PACKAGE_luci-i18n-base-ru=y
